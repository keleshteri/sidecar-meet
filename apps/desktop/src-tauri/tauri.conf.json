{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sidecar Meet",
  "version": "0.2.0",
  "identifier": "com.sidecar.meet",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Sidecar Meet", "width": 1060, "height": 780, "minWidth": 720, "minHeight": 620 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:" }
  },
  "bundle": { "active": false }
}
