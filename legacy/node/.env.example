# Copy this file to .env and fill in real values. .env is gitignored.

# Optional — Hugging Face model id for the whisper checkpoint used for
# transcription. Runs in-process via @huggingface/transformers (ONNX
# Runtime) — no manual binary/model download needed, it's fetched and
# cached automatically on first use. Default: Xenova/whisper-small.
WHISPER_MODEL_ID=Xenova/whisper-small

# Optional — ONNX Runtime quantization for the model weights: fp32, fp16,
# q8, or q4. Lower precision = faster/smaller, some accuracy trade-off.
# Default: q8.
WHISPER_DTYPE=q8

# Optional — ONNX Runtime execution provider. 'cpu' is the only one
# verified working here; 'dml' (DirectML, for GPU offload on the RTX 3050)
# segfaulted in testing with this onnxruntime-node/model combo — leave as
# cpu unless you've separately confirmed dml works for you. Default: cpu.
WHISPER_DEVICE=cpu

# Optional — how many seconds of audio to batch before running the model
# on it. Lower = fresher transcript but more per-chunk overhead. Default: 8.
WHISPER_CHUNK_SECONDS=8

# Optional — DirectShow device name for the virtual audio cable's recording
# side. Defaults to VB-Cable's standard name if unset. Verify the exact name
# on your machine with: ffmpeg -list_devices true -f dshow -i dummy
LISTENER_AUDIO_DEVICE=CABLE Output (VB-Audio Virtual Cable)

# Optional — audio-output device label (substring match) the bot routes
# the meeting's own audio to, via setSinkId() on the meeting page — not
# the OS-wide default playback device, so this doesn't affect any other
# app's sound. Default: "CABLE Input". See docs/phases/phase-1-bot-engine-api.md.
BOT_AUDIO_OUTPUT_DEVICE=CABLE Input

# Optional — display name auto-filled into Meet's guest "Your name" prompt
# when the bot isn't recognized as an authenticated session. Default:
# "Sidecar Notetaker".
BOT_DISPLAY_NAME=Sidecar Notetaker

# Set to "false" to skip the automated join-button/mic-unmute clicks and
# let a human click through the join flow by hand in the visible browser
# window instead. Currently the recommended default: scripted auto-join
# (true) is getting blocked by Meet's bot detection as of 2026-08-02 (see
# "Behavioral detection" in docs/phases/phase-1-bot-engine-api.md), while
# manual click-through reliably works. Flip to true once that's fixed, or
# whenever unattended joining is actually needed (e.g. Phase 3).
BOT_AUTO_JOIN=false
