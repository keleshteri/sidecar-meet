# Rust backend settings. Existing Node-specific .env keys are ignored.
# Defaults work without a .env after running scripts/download-model.ps1.
PORT=4343
WHISPER_MODEL_PATH=models/ggml-tiny.en.bin
WHISPER_CHUNK_SECONDS=8
LISTENER_AUDIO_DEVICE=CABLE Output (VB-Audio Virtual Cable)
# Optional absolute Chrome executable path if automatic discovery fails.
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# Optional persistent data/config root, especially for a copied executable.
# SIDECAR_HOME=D:/projects/sidecar-meet
